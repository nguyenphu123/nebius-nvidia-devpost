NEBIUS_API_KEY=your_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
PORT=3000
# PostgreSQL is the default. Never commit real connection credentials.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://second_serving:replace_with_your_password@127.0.0.1:5432/second_serving
