NEBIUS_API_KEY=your_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
PORT=3000
# PostgreSQL is the default. Never commit real connection credentials.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://second_serving:replace_with_your_password@127.0.0.1:5432/second_serving
# Hosted judge build: set these in Render's Environment page (not in Git).
# PUBLIC_ORIGIN=https://your-app.onrender.com
# HOST=0.0.0.0
# NODE_ENV=production
# JUDGE_ADMIN_USERNAME=judge
# JUDGE_ADMIN_PASSWORD=replace_with_a_unique_12_or_more_character_password
# JUDGE_SEED_DEMO=true
